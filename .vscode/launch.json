{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch TradingPlatform.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Presentation/TradingPlatform.Api/bin/Debug/net10.0/TradingPlatform.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Presentation/TradingPlatform.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_USE_POLLING_FILE_WATCHER": "true"
      }
    },
    {
      "name": "Launch TradingPlatform.Worker",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Presentation/TradingPlatform.Worker/bin/Debug/net10.0/TradingPlatform.Worker.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Presentation/TradingPlatform.Worker",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "DOTNET_USE_POLLING_FILE_WATCHER": "true"
      }
    }
  ]
}
