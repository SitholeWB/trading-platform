<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Trading Platform"
      Manufacturer="Trading Platform"
      Version="$(var.Version)"
      UpgradeCode="8b7d4c62-9e3a-4b1e-a5d4-7f2c1e9a8b01"
      Scope="perMachine">
    <SummaryInformation Description="Institutional Algorithmic Trading Platform Desktop" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Trading Platform" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Trading Platform">
        <Component Id="ApplicationShortcut" Guid="d4e8f9a1-2b3c-4d5e-8f6a-1b2c3d4e5f6a">
          <Shortcut
              Id="ApplicationStartMenuShortcut"
              Name="Trading Platform"
              Description="Institutional Algorithmic Trading Platform"
              Target="[INSTALLFOLDER]trading_platform.exe"
              WorkingDirectory="INSTALLFOLDER"
              Icon="AppIcon" />
          <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\TradingPlatform" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Trading Platform" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Package>
</Wix>
