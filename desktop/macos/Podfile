platform :osx, '12.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end

  # webview_cef: embed the CEF helper sub-process apps so CEF runs
  # multi-process on macOS.
  cef_helpers = File.expand_path(
    'Flutter/ephemeral/.symlinks/plugins/webview_cef/macos/embed_cef_helpers.rb', __dir__)
  if File.exist?(cef_helpers)
    require cef_helpers
    WebviewCEF.install_helper_phase(installer)
  end
end

post_integrate do |_installer|
  # Fix CocoaPods splitting "Chromium Embedded Framework" into:
  #   Embedded Framework -framework "Chromium"
  # in generated Pods-Runner.*.xcconfig OTHER_LDFLAGS after xcconfigs are written.
  Dir.glob(File.join(__dir__, 'Pods/Target Support Files/Pods-Runner/Pods-Runner.*.xcconfig')).each do |path|
    content = File.read(path)
    fixed = content
      .gsub(/Embedded\s+Framework\s+-framework\s+"?Chromium"?/, '-framework "Chromium Embedded Framework"')
      .gsub(/-framework\s+Chromium\s+Embedded\s+Framework(?!")/, '-framework "Chromium Embedded Framework"')
    if fixed != content
      File.write(path, fixed)
      puts "Patched Chromium Embedded Framework flag in #{File.basename(path)}"
    end
  end
end
