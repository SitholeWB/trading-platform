<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Enforce Roslyn code style rules at build time -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Suppress NU1900: emitted when offline/sandboxed builds cannot connect to live NuGet vulnerability service -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="ProjectDir" />
  </ItemGroup>

  <ItemGroup>
    <!-- Use 2.1.12 to eliminate vulnerability warning GHSA-2m69-gcr7-jv3q -->
    <PackageReference Update="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Update="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Update="SQLitePCLRaw.core" Version="2.1.12" />
  </ItemGroup>
</Project>
